# ORTOBOM ARACAJU — variáveis de ambiente (todas opcionais; o projeto sobe sem nenhuma)

# Endereço público, só quando a loja tiver domínio próprio.
# NEXT_PUBLIC_SITE_URL=https://ortobomaracaju.com.br

# Supabase (os dois juntos, ou nenhum: sem eles o site lê data/catalogo.json)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Painel em modo local
# PAINEL_SENHA_LOCAL=ortobom
# PAINEL_SEGREDO=troque-por-uma-frase-longa
